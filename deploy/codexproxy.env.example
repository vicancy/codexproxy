# Path to node runtime used by the systemd service.
# Update this when Node is upgraded or moved.
NODE_BIN=/root/.nvm/versions/node/v22.22.0/bin/node

# Proxy listen address (keep loopback unless you know why you need otherwise).
LISTEN_HOST=127.0.0.1
LISTEN_PORT=17777

# Select the upstream provider: azure or github-copilot.
UPSTREAM_PROVIDER=azure

# Azure OpenAI endpoint and scope.
UPSTREAM_AOAI_BASE_URL=https://pmagent2.openai.azure.com/openai/v1
AZURE_OPENAI_SCOPE=https://cognitiveservices.azure.com/.default

# GitHub Copilot bridge (community project, optional).
# bridge preserves existing deployments; direct removes the bridge dependency.
COPILOT_TRANSPORT=bridge
COPILOT_PROXY_BASE_URL=http://127.0.0.1:4141/v1
COPILOT_PROXY_API_KEY=

# Native Copilot (unofficial internal API). Credentials are never stored here.
COPILOT_ACCOUNT_TYPE=individual
# Default: ~/.local/share/codexproxy/github_token for the service user.
# COPILOT_TOKEN_FILE=/home/your-user/.local/share/codexproxy/github_token

# Runtime timeouts and token refresh window (milliseconds).
TOKEN_REFRESH_BUFFER_MS=300000
UPSTREAM_HEADERS_TIMEOUT_MS=30000
UPSTREAM_BODY_TIMEOUT_MS=600000
