[Unit]
Description=Codex WSL Proxy for Azure OpenAI or GitHub Copilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__PROJECT_OWNER__
Group=__PROJECT_GROUP__
WorkingDirectory=__PROJECT_DIR__

# Safe defaults. Override in /etc/default/codexproxy.
Environment=HOME=__PROJECT_HOME__
Environment="PATH=__NODE_BIN_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/mnt/c/Program Files/Microsoft SDKs/Azure/CLI2/wbin"
Environment=NODE_BIN=/root/.nvm/versions/node/v22.22.0/bin/node
Environment=LISTEN_HOST=127.0.0.1
Environment=LISTEN_PORT=17777
Environment=UPSTREAM_PROVIDER=azure
Environment=UPSTREAM_AOAI_BASE_URL=https://pmagent2.openai.azure.com/openai/v1
Environment=AZURE_OPENAI_SCOPE=https://cognitiveservices.azure.com/.default
Environment=TOKEN_REFRESH_BUFFER_MS=300000
Environment=UPSTREAM_HEADERS_TIMEOUT_MS=30000
Environment=UPSTREAM_BODY_TIMEOUT_MS=600000
EnvironmentFile=-/etc/default/codexproxy

ExecStartPre=/bin/bash -lc 'test -x "${NODE_BIN}"'
ExecStartPre=/bin/bash -lc 'if [ "${UPSTREAM_PROVIDER}" = azure ]; then command -v az >/dev/null; fi'
ExecStart=/bin/bash -lc 'exec "${NODE_BIN}" "__PROJECT_DIR__/src/index.js"'

Restart=always
RestartSec=3
SyslogIdentifier=codexproxy
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
